rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helper
    // ------------------------------------------------------------------
    function isAdmin() {
      return request.auth != null;
    }

    // ------------------------------------------------------------------
    // Katalog sekolah (publik). Hanya admin yang bisa tulis.
    // ------------------------------------------------------------------
    match /schools/{schoolId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Galeri studio (publik). Hanya admin yang bisa tulis.
    // ------------------------------------------------------------------
    match /gallery/{photoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Konten sekolah berpassword. Doc ID = "{schoolId}__{sha256(password)}".
    // get diizinkan (pengunjung harus sudah tahu hash-nya), list ditutup
    // supaya koleksi tidak bisa di-enumerate.
    // ------------------------------------------------------------------
    match /protected/{docId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Bookkeeping admin (hash password aktif per sekolah). Tidak publik.
    // ------------------------------------------------------------------
    match /admin_meta/{schoolId} {
      allow read, write: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Invoice & struk digital.
    //   get   : publik — supaya link struk bisa dibuka klien tanpa login.
    //   list  : admin saja — riwayat transaksi tidak boleh bisa di-browse.
    //   write : admin saja.
    // Inilah blok yang bikin data invoice nyangkut di localStorage kalau
    // belum ter-publish: tanpa blok ini semua tulis kena default deny.
    // ------------------------------------------------------------------
    match /invoices/{invoiceId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Tutup semua koleksi lain yang belum didefinisikan.
    // ------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
